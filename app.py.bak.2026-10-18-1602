def _redact_log_text(value: str) -> str:
    """Mask common credentials before diagnostic text is written to logs."""
    body = value
    body = re.sub(r'(?i)bearer\s+[^\s,;"\']+', 'Bearer [REDACTED]', body)
    body = re.sub(r'(?i)\bsk-[A-Za-z0-9_-]+', '[REDACTED_KEY]', body)
    body = re.sub(r'(?i)("?(?:authorization|access_token|refresh_token|token|api[_-]?key|secret)"?\s*[:=]\s*"?)[^\s,"}]+', r'\1[REDACTED]', body)
    body = re.sub(r'\beyJ[A-Za-z0-9_-]*\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+', '[REDACTED_JWT]', body)
    return body


def _upstream_error_details(exc: Exception) -> tuple[int | str, str]:
    """Return a short, credential-redacted Open WebUI response summary for logs."""
    response = getattr(exc, 'response', None)
    if response is None:
        return '-', '-'
    try:
        status = response.status_code
    except Exception:
        status = '-'
    try:
        body = response.text[:200]
    except Exception:
        body = ''
    return status, _redact_log_text(body)


def _log_chat_stream_exception(status: str, uid: int, model_id: str, exc: Exception) -> None:
    """Log a full traceback while replacing its exception text with a redacted copy."""
    http_status, http_body = _upstream_error_details(exc)
    safe_exception = Exception(_redact_log_text(str(exc)))
    logger.exception(
        'chat user_id=%s model_id=%s status=%s charged=0 exception_class=%s http_status=%s http_body=%r',
        uid, model_id, status, type(exc).__name__, http_status, http_body,
        exc_info=(type(exc), safe_exception, exc.__traceback__),
    )

