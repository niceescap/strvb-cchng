MILLION = Decimal(1_000_000)


def _ceil_decimal(value: Decimal) -> int:
    return int(value.to_integral_value(rounding=ROUND_CEILING))


def provider_debit_micro_usd(usage_cost) -> int:
    """Convert provider USD cost to the 10x integer micro-dollar charge."""
    amount = Decimal(str(usage_cost))
    if not amount.is_finite() or amount < 0:
        raise ValueError('invalid provider cost')
    return _ceil_decimal(amount * Decimal(10) * MILLION)


def estimated_debit_micro_usd(prompt_tokens: int, completion_tokens: int,
                              price_in: int, price_out: int) -> int:
    provider_micro = Decimal(prompt_tokens) * Decimal(price_in) + Decimal(completion_tokens) * Decimal(price_out)
    return _ceil_decimal(provider_micro * Decimal(10) / MILLION)


def maximum_debit_micro_usd(input_characters: int, max_tokens: int,
                            price_in: int, price_out: int) -> int:
    provider_micro = Decimal(input_characters) * Decimal(price_in) + Decimal(max_tokens) * Decimal(price_out)
    return _ceil_decimal(provider_micro * Decimal(10) / MILLION)


