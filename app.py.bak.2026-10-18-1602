@app.post('/api/credits/redeem')
def redeem_coupon(
    request: Request,
    code: Annotated[str, Form()],
    csrf_token: Annotated[str, Form()],
    user: User = Depends(current_user),
    db: Session = Depends(get_db),
):
    now_mono = time.monotonic()
    recent = [t for t in _coupon_attempts.get(user.id, []) if now_mono - t < 60]
    if len(recent) >= 5:
        logger.info('coupon redemption user_id=%s at=%s result=rate_limited', user.id, datetime.now(timezone.utc).isoformat())
        raise HTTPException(status_code=429, detail=COUPON_FAILURE)
    _coupon_attempts[user.id] = recent + [now_mono]
    if not secrets.compare_digest(request.cookies.get('coach_credit_csrf', ''), csrf_token):
        logger.info('coupon redemption user_id=%s at=%s result=failure', user.id, datetime.now(timezone.utc).isoformat())
        raise HTTPException(status_code=403, detail=COUPON_FAILURE)

    secret = os.getenv('COUPON_HMAC_SECRET', '')
    if len(secret) < 32:
        logger.error('COUPON_HMAC_SECRET is absent or too short')
        logger.info('coupon redemption user_id=%s at=%s result=failure', user.id, datetime.now(timezone.utc).isoformat())
        raise HTTPException(status_code=500, detail='Erreur interne.')

    code = code.strip()
    code_hash = hmac.new(secret.encode(), code.encode(), hashlib.sha256).hexdigest()
    try:
        with db.begin_nested():
            coupon = db.execute(text('SELECT id, amount_micro_usd, expires_at, max_redemptions, active FROM coupons WHERE code_hash = :h FOR UPDATE'), {'h': code_hash}).mappings().first()
            if not coupon or not coupon['active'] or coupon['expires_at'] <= datetime.now(timezone.utc):
                raise ValueError('unavailable')
            redeemed = db.execute(text('SELECT count(*) FROM coupon_redemptions WHERE coupon_id = :cid'), {'cid': coupon['id']}).scalar_one()
            if redeemed >= coupon['max_redemptions']:
                raise ValueError('unavailable')
            db.execute(text('INSERT INTO coupon_redemptions (coupon_id, user_id) VALUES (:cid, :uid)'), {'cid': coupon['id'], 'uid': user.id})
            balance = db.execute(text('UPDATE coach_users SET credit_micro_usd = credit_micro_usd + :amount WHERE id = :uid RETURNING credit_micro_usd'), {'amount': coupon['amount_micro_usd'], 'uid': user.id}).scalar_one()
            db.execute(text("INSERT INTO credit_ledger (user_id, delta_micro_usd, reason, request_id, note) VALUES (:uid, :amount, 'grant', :rid, 'coupon')"), {'uid': user.id, 'amount': coupon['amount_micro_usd'], 'rid': f"coupon-{coupon['id']}-{user.id}"})
        db.commit()
        logger.info('coupon redemption user_id=%s at=%s result=success', user.id, datetime.now(timezone.utc).isoformat())
        dollars, reste = divmod(coupon['amount_micro_usd'], 1000000)
        cents = reste // 10000
        return {'credit_micro_usd': balance, 'message': f"Crédit ajouté : {dollars}.{cents:02d} $"}
    except (ValueError, IntegrityError):
        logger.info('coupon redemption user_id=%s at=%s result=failure', user.id, datetime.now(timezone.utc).isoformat())
        raise HTTPException(status_code=400, detail=COUPON_FAILURE)


