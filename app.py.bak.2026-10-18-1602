def completed_content(payload: dict) -> str:
    choice = payload['choices'][0]
    content = choice['message']['content']
    if not isinstance(content, str) or not content.strip() or choice.get('finish_reason') == 'length':
        raise ValueError('incomplete response')
    return content


def validate_chat_messages(messages) -> tuple[list[dict[str, str]], int]:
    """Validate client conversation history and return it with total characters."""
    invalid = HTTPException(status_code=400, detail='Messages invalides')
    if not isinstance(messages, list) or not 1 <= len(messages) <= 20:
        raise invalid
    cleaned: list[dict[str, str]] = []
    total = 0
    for item in messages:
        if not isinstance(item, dict) or set(item) != {'role', 'content'}:
            raise invalid
        role, content = item.get('role'), item.get('content')
        if not isinstance(role, str) or role not in {'user', 'assistant'} or not isinstance(content, str) or not content.strip() or len(content) > 4000:
            raise invalid
        total += len(content)
        if total > 30000:
            raise invalid
        cleaned.append({'role': role, 'content': content})
    if cleaned[-1]['role'] != 'user':
        raise invalid
    return cleaned, total


def _number_or_zero(value) -> int:
    try:
        return max(0, int(value or 0))
    except (TypeError, ValueError, OverflowError):
        return 0


def charge_response(db: Session, *, user_id: int, model_id: str, request_id: str,
                    debit: int, prompt_tokens: int, completion_tokens: int,
                    usage_source: str, note: str) -> tuple[int, int]:
    """Atomically charge available credit and append the matching ledger row."""
    try:
        balance = db.execute(text(
            'UPDATE coach_users SET credit_micro_usd = credit_micro_usd - :debit '
            'WHERE id = :uid AND credit_micro_usd >= :debit RETURNING credit_micro_usd'
        ), {'debit': debit, 'uid': user_id}).scalar_one_or_none()
        effective = debit
        ledger_note = note
        if balance is None:
            remaining = db.execute(text(
                'SELECT credit_micro_usd FROM coach_users WHERE id = :uid FOR UPDATE'
            ), {'uid': user_id}).scalar_one()
            effective = min(debit, remaining)
            balance = db.execute(text(
                'UPDATE coach_users SET credit_micro_usd = credit_micro_usd - :debit '
                'WHERE id = :uid AND credit_micro_usd >= :debit RETURNING credit_micro_usd'
            ), {'debit': effective, 'uid': user_id}).scalar_one()
            ledger_note = f'{note}; partiel : {debit - effective} micro-dollars non facturés'
        db.execute(text(
            'INSERT INTO credit_ledger (user_id, delta_micro_usd, reason, request_id, '
            'model_id, prompt_tokens, completion_tokens, usage_source, note) '
            'VALUES (:uid, :delta, \'charge\', :rid, :mid, :pt, :ct, :source, :note)'
        ), {'uid': user_id, 'delta': -effective, 'rid': request_id, 'mid': model_id,
            'pt': prompt_tokens, 'ct': completion_tokens, 'source': usage_source,
            'note': ledger_note})
        db.commit()
        balance = db.execute(text(
            'SELECT credit_micro_usd FROM coach_users WHERE id = :uid'
        ), {'uid': user_id}).scalar_one()
        db.rollback()
    except Exception:
        db.rollback()
        raise
    return effective, balance



def hash_password(password: str, salt: str | None = None) -> str:
    salt = salt or secrets.token_hex(16)
    digest = hashlib.pbkdf2_hmac('sha256', password.encode(), bytes.fromhex(salt), 310_000)
    return f'pbkdf2_sha256${salt}${digest.hex()}'


def verify_password(password: str, stored: str) -> bool:
    try:
        method, salt, digest = stored.split('$')
        if method != 'pbkdf2_sha256':
            return False
        return hmac.compare_digest(hash_password(password, salt).split('$')[-1], digest)
    except (ValueError, TypeError):
        return False


def sign_session(user_id: int) -> str:
    expiry = int(time.time()) + SESSION_SECONDS
    payload = f'{user_id}:{expiry}'
    sig = hmac.new(SESSION_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()
    return f'{payload}:{sig}'


def verify_session(cookie: str | None) -> int | None:
    try:
        if not cookie:
            return None
        uid, expiry, signature = cookie.split(':')
        payload = f'{uid}:{expiry}'
        expected = hmac.new(SESSION_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()
        if int(expiry) < int(time.time()) or not hmac.compare_digest(signature, expected):
            return None
        return int(uid)
    except (ValueError, TypeError):
        return None


