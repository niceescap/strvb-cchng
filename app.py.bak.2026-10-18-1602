@app.get('/api/openwebui/models')
def openwebui_models(user: User = Depends(current_user)):
    allowed_ids = {
        model_id.strip()
        for model_id in os.getenv('OPENWEBUI_COACH_MODELS', '').split(',')
        if model_id.strip()
    }
    if not allowed_ids:
        logger.warning('Open WebUI model list is empty: no Coach model allowlist is configured')
        return []

    base_url = os.getenv('OPENWEBUI_BASE_URL', '').rstrip('/')
    api_key = os.getenv('OPENWEBUI_API_KEY', '')
    if not base_url or not api_key:
        logger.warning('Open WebUI model request is not configured')
        raise HTTPException(status_code=502, detail='Modèles indisponibles')

    try:
        response = httpx.get(
            f'{base_url}/api/models',
            headers={'Authorization': f'Bearer {api_key}'},
            timeout=15,
        )
        response.raise_for_status()
        payload = response.json()
    except httpx.HTTPStatusError as exc:
        logger.warning('Open WebUI model request returned HTTP %s', exc.response.status_code)
        raise HTTPException(status_code=502, detail='Modèles indisponibles') from exc
    except (httpx.RequestError, ValueError) as exc:
        logger.warning('Open WebUI model request failed (%s)', type(exc).__name__)
        raise HTTPException(status_code=502, detail='Modèles indisponibles') from exc

    models = payload.get('data') if isinstance(payload, dict) else payload
    if not isinstance(models, list):
        logger.warning('Open WebUI model response has an invalid structure')
        raise HTTPException(status_code=502, detail='Modèles indisponibles')

    selected = []
    for model in models:
        if not isinstance(model, dict):
            continue
        model_id = model.get('id')
        if not isinstance(model_id, str) or model_id not in allowed_ids:
            continue
        name = model.get('name')
        selected.append({'id': model_id, 'name': name if isinstance(name, str) else model_id})
    return selected


@app.post('/api/chat')
async def chat(request: Request, user: User = Depends(current_user), db: Session = Depends(get_db)):
    """Relay Open WebUI's HTTP SSE stream and charge after its complete answer."""
    uid = user.id
    try:
        body = await request.json()
    except Exception as exc:
        raise HTTPException(status_code=400, detail='Requête invalide') from exc
    model_id = body.get('model') if isinstance(body, dict) else None
    raw_messages = body.get('messages') if isinstance(body, dict) else None
    discussion_id = body.get('discussion_id') if isinstance(body, dict) else None
    if not isinstance(model_id, str):
        raise HTTPException(status_code=422, detail='Modèle ou message invalide')
    messages, input_characters = validate_chat_messages(raw_messages)
    if (not isinstance(discussion_id, str) or len(discussion_id) > 46
            or re.fullmatch(r'temporary:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}', discussion_id) is None):
        raise HTTPException(status_code=422, detail='Identifiant de discussion invalide')

    context = db.get(ChatContext, discussion_id)
    if context is None:
        try:
            db.add(ChatContext(discussion_id=discussion_id, user_id=uid, context_version=0))
            db.commit()
        except IntegrityError:
            db.rollback()
        context = db.get(ChatContext, discussion_id)
    if context is None or context.user_id != uid:
        raise HTTPException(status_code=404, detail='Discussion not found')
    from services.context_payload import build_context
    context_payload = build_context(db, discussion_id, uid)
    context_message = f'Identifiant de discussion Coach : {discussion_id}'
    if context_payload is not None:
        context_message += '\nContexte d’analyse sélectionné par l’athlète (JSON) :\n' + json.dumps(
            context_payload, ensure_ascii=False, separators=(',', ':'))
    messages.insert(0, {'role': 'system', 'content': context_message})
    input_characters += len(context_message)

    allowed_ids = {item.strip() for item in os.getenv('OPENWEBUI_COACH_MODELS', '').split(',') if item.strip()}
    if model_id not in allowed_ids:
        raise HTTPException(status_code=403, detail='Modèle indisponible')
    free_ids = {item.strip() for item in os.getenv('OPENWEBUI_FREE_MODELS', '').split(',') if item.strip()}
    is_free = model_id in free_ids
    price = db.execute(text(
        'SELECT provider_micro_usd_per_mtok_in, provider_micro_usd_per_mtok_out '
        'FROM model_pricing WHERE model_id = :mid AND active = true'
    ), {'mid': model_id}).mappings().first()
    if not price and not is_free:
        raise HTTPException(status_code=403, detail='Modèle indisponible')
    max_tokens = 2048
    max_charge = maximum_debit_micro_usd(input_characters, max_tokens,
                                         price['provider_micro_usd_per_mtok_in'],
                                         price['provider_micro_usd_per_mtok_out']) if price else 0
    if not is_free and max_charge <= 0:
        logger.error('chat invalid_pricing user_id=%s model_id=%s', uid, model_id)
        raise HTTPException(status_code=503, detail='Tarif indisponible')
    balance = db.scalar(select(User.credit_micro_usd).where(User.id == uid))
    if balance is None:
        raise HTTPException(status_code=402, detail='Solde insuffisant')
    if not is_free:
        require_sufficient_balance(balance, max_charge)
    base_url = os.getenv('OPENWEBUI_BASE_URL', '').rstrip('/')
    api_key = os.getenv('OPENWEBUI_API_KEY', '')
    if not base_url or not api_key:
        raise HTTPException(status_code=502, detail='Modèles indisponibles')

    upstream_body = {
        'model': model_id,
        'messages': messages,
        'stream': True,
        'max_tokens': max_tokens,
    }
    tool_ids = [item.strip() for item in os.getenv('OPENWEBUI_TOOL_IDS', '').split(',') if item.strip()]
    if tool_ids:
        upstream_body['tool_ids'] = tool_ids
    request_id = str(uuid.uuid4())
    # Context and pricing reads opened an ORM transaction; close it before the stream.
    db.rollback()

    def sse(event_name: str, payload: dict) -> str:
        data = json.dumps(payload, ensure_ascii=False, separators=(',', ':'))
        return 'event: ' + event_name + '\ndata: ' + data + '\n\n'

    async def iter_sse_data(response):
        buffer = ''
        data_lines = []
        decoder = codecs.getincrementaldecoder('utf-8')('strict')

        def consume_line(line: str):
            if line.endswith('\r'):
                line = line[:-1]
            if line == '':
                if not data_lines:
                    return None
                event_data = '\n'.join(data_lines)
                data_lines.clear()
                return event_data
            if line.startswith('data:'):
                data_lines.append(line[5:].lstrip(' '))
            return None

        async for chunk in response.aiter_bytes():
            buffer += decoder.decode(chunk)
            while '\n' in buffer:
                line, buffer = buffer.split('\n', 1)
                event_data = consume_line(line)
                if event_data is not None:
                    yield event_data
        buffer += decoder.decode(b'', final=True)
        if buffer:
            event_data = consume_line(buffer)
            if event_data is not None:
                yield event_data
        if data_lines:
            yield '\n'.join(data_lines)

    async def relay():
        aggregate = {'content': '', 'usage': {}, 'finish_reason': None}
        upstream_done = False
        charged = 0
        try:
            timeout = httpx.Timeout(185, connect=15, read=185)
            async with httpx.AsyncClient(timeout=timeout) as client:
                async with asyncio.timeout(185):
                    async with client.stream(
                        'POST', base_url + '/api/chat/completions',
                        headers={'Authorization': 'Bearer ' + api_key}, json=upstream_body,
                    ) as response:
                        if response.is_error:
                            await response.aread()
                            response.raise_for_status()
                        yield sse('ready', {'status': 'connected'})
                        async with asyncio.timeout(185):
                            async for event_data in iter_sse_data(response):
                                if not event_data.strip():
                                    continue
                                if event_data.strip() == '[DONE]':
                                    upstream_done = True
                                    break
                                try:
                                    chunk = json.loads(event_data)
                                except (json.JSONDecodeError, TypeError) as exc:
                                    raise ValueError('Invalid Open WebUI SSE JSON') from exc
                                if not isinstance(chunk, dict):
                                    raise ValueError('Invalid Open WebUI SSE chunk')
                                if chunk.get('error'):
                                    logger.error('chat user_id=%s model_id=%s status=upstream_error charged=0 error_chunk=1',
                                                 uid, model_id)
                                    yield sse('error', {'detail': 'Réponse du modèle interrompue'})
                                    return
                                choices = chunk.get('choices')
                                if choices is not None and not isinstance(choices, list):
                                    raise ValueError('Invalid Open WebUI choices')
                                for choice in choices or []:
                                    if not isinstance(choice, dict):
                                        continue
                                    delta = choice.get('delta')
                                    if isinstance(delta, dict) and isinstance(delta.get('content'), str):
                                        aggregate['content'] += delta['content']
                                    if choice.get('finish_reason') is not None:
                                        aggregate['finish_reason'] = choice['finish_reason']
                                snapshot = chunk.get('content')
                                if isinstance(snapshot, str) and snapshot:
                                    aggregate['content'] = snapshot
                                elif isinstance(snapshot, list):
                                    snapshot_text = ''.join(
                                        block.get('text', block.get('content', ''))
                                        for block in snapshot if isinstance(block, dict)
                                        and isinstance(block.get('text', block.get('content', '')), str))
                                    if snapshot_text:
                                        aggregate['content'] = snapshot_text
                                output = chunk.get('output')
                                if isinstance(output, list):
                                    output_text = ''.join(
                                        item.get('text', '') for item in output
                                        if isinstance(item, dict)
                                        and item.get('type') in {'text', 'output_text'}
                                        and isinstance(item.get('text', ''), str))
                                    if output_text:
                                        aggregate['content'] = output_text
                                usage = chunk.get('usage')
                                if isinstance(usage, dict):
                                    aggregate['usage'].update(usage)
                                yield sse('openwebui', {'type': 'chat:completion', 'data': chunk})
            if not upstream_done:
                logger.info('chat user_id=%s model_id=%s status=incomplete charged=0 reason=eof_without_done',
                            uid, model_id)
                yield sse('error', {'detail': 'Le flux du modèle s’est terminé prématurément'})
                return
            if not aggregate['content'].strip() or aggregate['finish_reason'] == 'length':
                logger.info('chat user_id=%s model_id=%s status=incomplete charged=0 reason=%s',
                            uid, model_id,
                            'empty_content' if not aggregate['content'].strip() else 'length_finish_reason')
                yield sse('error', {'detail': 'Réponse du modèle incomplète'})
                return
            if await request.is_disconnected():
                logger.info('chat user_id=%s model_id=%s status=client_disconnected charged=0', uid, model_id)
                return

            usage = aggregate['usage']
            prompt_value = usage.get('prompt_tokens', usage.get('input_tokens'))
            completion_value = usage.get('completion_tokens', usage.get('output_tokens'))
            prompt_tokens = _number_or_zero(prompt_value)
            completion_tokens = _number_or_zero(completion_value)
            usage_cost = usage.get('cost')
            note_cost = str(usage_cost) if usage_cost is not None else 'absent'
            if is_free:
                settled = {'content': aggregate['content'], 'charged_micro_usd': 0,
                           'balance_micro_usd': balance}
                charged = 0
            else:
                if usage_cost is not None:
                    try:
                        debit = provider_debit_micro_usd(usage_cost)
                        source = 'provider'
                    except Exception:
                        debit, source = max_charge, 'estimated'
                        logger.error('chat usage_cost_invalid user_id=%s model_id=%s charged_max=1', uid, model_id)
                elif prompt_value is None or completion_value is None:
                    debit, source = max_charge, 'estimated'
                    logger.error('chat usage_tokens_missing user_id=%s model_id=%s charged_max=1', uid, model_id)
                else:
                    debit = estimated_debit_micro_usd(
                        prompt_tokens, completion_tokens,
                        price['provider_micro_usd_per_mtok_in'],
                        price['provider_micro_usd_per_mtok_out'])
                    source = 'estimated'
                try:
                    charged, new_balance = charge_response(
                        db, user_id=uid, model_id=model_id, request_id=request_id,
                        debit=debit, prompt_tokens=prompt_tokens,
                        completion_tokens=completion_tokens, usage_source=source,
                        note='upstream_usd=' + note_cost)
                except SQLAlchemyError as exc:
                    db.rollback()
                    logger.exception('chat user_id=%s model_id=%s status=charge_error exception_class=%s exception=%s charged=unknown',
                                     uid, model_id, type(exc).__name__, str(exc))
                    yield sse('error', {'detail': 'Débit impossible'})
                    return
                settled = {'content': aggregate['content'], 'charged_micro_usd': charged,
                           'balance_micro_usd': new_balance}
            yield sse('settled', settled)
            yield sse('done', {'ok': True})
            logger.info('chat user_id=%s model_id=%s prompt_tokens=%s completion_tokens=%s charged=%s status=delivered',
                        uid, model_id, prompt_tokens, completion_tokens, charged)
        except asyncio.CancelledError:
            logger.info('chat user_id=%s model_id=%s status=cancelled charged=%s', uid, model_id, charged)
            raise
        except GeneratorExit:
            logger.info('chat user_id=%s model_id=%s status=client_disconnect charged=%s', uid, model_id, charged)
            raise
        except asyncio.TimeoutError as exc:
            logger.info('chat user_id=%s model_id=%s status=timeout charged=0', uid, model_id)
            yield sse('error', {'detail': 'Le flux du modèle a expiré'})
        except httpx.TimeoutException as exc:
            logger.info('chat user_id=%s model_id=%s status=timeout charged=0 exception_class=%s',
                        uid, model_id, type(exc).__name__)
            yield sse('error', {'detail': 'Le flux du modèle a expiré'})
        except httpx.HTTPStatusError as exc:
            _log_chat_stream_exception('upstream_http_error', uid, model_id, exc)
            yield sse('error', {'detail': 'Réponse du modèle indisponible'})
        except httpx.RequestError as exc:
            _log_chat_stream_exception('upstream_error', uid, model_id, exc)
            yield sse('error', {'detail': 'Réponse du modèle indisponible'})
        except (ValueError, UnicodeDecodeError) as exc:
            _log_chat_stream_exception('invalid_sse', uid, model_id, exc)
            yield sse('error', {'detail': 'Flux SSE du modèle invalide'})
        except Exception as exc:
            _log_chat_stream_exception('stream_error', uid, model_id, exc)
            yield sse('error', {'detail': 'Réponse du modèle indisponible'})

    logger.info('chat user_id=%s model_id=%s status=stream_started charged=0', uid, model_id)
    return StreamingResponse(relay(), media_type='text/event-stream', headers={
        'Cache-Control': 'no-cache, no-transform',
        'X-Accel-Buffering': 'no',
    })

@app.post('/api/profile')
async def update_profile(request: Request, user: User = Depends(current_user), db: Session = Depends(get_db)):
    """Save athlete constants; true FTP/HRmax are preferred over estimates."""
    try:
        body = await request.json()
    except Exception as exc:
        raise HTTPException(status_code=400, detail='Invalid JSON body') from exc
    if not isinstance(body, dict):
        raise HTTPException(status_code=400, detail='Invalid JSON body')
    validators = {
        'weight_kg': (0.1, 300.0, float),
        'ftp_watts': (1, 2000, int),
        'max_heartrate': (30, 250, int),
    }
    for key, (low, high, cast) in validators.items():
        if key not in body:
            continue
        value = body[key]
        if value is None or value == '':
            setattr(user, key, None)
            continue
        try:
            parsed = cast(value)
        except (TypeError, ValueError, OverflowError) as exc:
            raise HTTPException(status_code=422, detail=f'{key} must be numeric') from exc
        if not low <= parsed <= high:
            raise HTTPException(status_code=422, detail=f'{key} is outside the accepted range')
        setattr(user, key, parsed)
    cache = db.get(LevelSnapshotCache, user.id)
    if cache is not None:
        db.delete(cache)
    db.commit()
    return {'status': 'saved', 'weight_kg': float(user.weight_kg) if user.weight_kg is not None else None,
            'ftp_watts': user.ftp_watts, 'max_heartrate': user.max_heartrate}


